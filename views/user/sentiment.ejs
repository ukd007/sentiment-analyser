<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Sentiment Analysis</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/styles/sentiment.css">
</head>
<body>
  <div class="container py-4">
    <h1 class="fw-bold">Sentiment Analysis</h1>
    <p class="text-muted">Analyze the emotional tone and sentiment of stakeholder comments</p>

    <div class="row g-4 mb-4">
      <!-- Distribution Card -->
      <div class="col-md-6 col-lg-3">
        <div class="card h-100 p-3 sentiment-distribution">
          <h5 class="fw-semibold">📊 Overall Sentiment</h5>
          <p class="small text-muted">Distribution across all comments</p>

          <div class="mb-3">
            <div class="d-flex justify-content-between">
              <span class="fw-medium text-success">Positive</span>
              <span id="posPercent" class="fw-semibold">0%</span>
            </div>
            <div class="progress">
              <div id="posBar" class="progress-bar bg-success" style="width:0%"></div>
            </div>
          </div>

          <div class="mb-3">
            <div class="d-flex justify-content-between">
              <span class="fw-medium text-secondary">Neutral</span>
              <span id="neuPercent" class="fw-semibold">0%</span>
            </div>
            <div class="progress">
              <div id="neuBar" class="progress-bar bg-secondary" style="width:0%"></div>
            </div>
          </div>

          <div>
            <div class="d-flex justify-content-between">
              <span class="fw-medium text-danger">Negative</span>
              <span id="negPercent" class="fw-semibold">0%</span>
            </div>
            <div class="progress">
              <div id="negBar" class="progress-bar bg-danger" style="width:0%"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Positive / Neutral / Negative count cards -->
      <div class="col-md-6 col-lg-3">
        <div class="card h-100 p-3 text-center positive-card">
          <h6 class="fw-semibold">Positive Comments</h6>
          <p id="pos-count" class="display-6 fw-bold text-success mb-1">0</p>
          <p class="small text-success">--</p>
        </div>
      </div>

      <div class="col-md-6 col-lg-3">
        <div class="card h-100 p-3 text-center neutral-card">
          <h6 class="fw-semibold">Neutral Comments</h6>
          <p id="neu-count" class="display-6 fw-bold text-secondary mb-1">0</p>
          <p class="small text-secondary">--</p>
        </div>
      </div>

      <div class="col-md-6 col-lg-3">
        <div class="card h-100 p-3 text-center negative-card">
          <h6 class="fw-semibold">Negative Comments</h6>
          <p id="neg-count" class="display-6 fw-bold text-danger mb-1">0</p>
          <p class="small text-danger">--</p>
        </div>
      </div>
    </div>

    <!-- Comment-by-Comment Analysis -->
    <div class="card p-4 comment-analysis">
      <h4 class="fw-bold mb-2">Comment-by-Comment Analysis</h4>
      <p class="text-muted mb-4">Detailed sentiment analysis for each stakeholder comment</p>

      <div id="comments-list">
        <!-- JS will inject comment cards here -->
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/scripts/sentiment.js"></script>
</body>
</html>
