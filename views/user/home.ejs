<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>E-Consult Feedback Analyser</title>
  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="styles/home.css">
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-success">
    <div class="container-fluid">
      <a class="navbar-brand fw-bold" href="#">
        <i class="bi bi-layers"></i> E-Consult Feedback Analyser
      </a>
      <span class="navbar-text text-white">
        Analyse public feedback on draft legislation
      </span>
      <div class="ms-auto d-flex align-items-center">
        <a href="#" class="nav-link text-white"><i class="bi bi-house-door"></i></a>
        <a href="#" class="nav-link text-white"><i class="bi bi-person"></i></a>
        <a href="#" class="nav-link text-white"><i class="bi bi-gear"></i></a>
      </div>
    </div>
  </nav>

  <!-- Welcome Banner -->
  <section class="welcome-banner text-white">
    <div class="container py-4">
      <h2 class="fw-bold">Welcome to AI eConsultation Analyzer</h2>
      <p class="mb-0">Efficiently analyze public feedback on draft legislation with AI-powered insights</p>
    </div>
  </section>

  <!-- Main Content -->
  <div class="container my-4">
    <div class="row g-3">
      <!-- Total Comments -->
      <div class="col-md-3">
        <div class="card h-100 p-3 d-flex justify-content-between">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h4 class="mb-0">1,248</h4>
              <small>Total Comments</small>
            </div>
            <i class="bi bi-people"></i>
          </div>
        </div>
      </div>

      <!-- Positive Sentiment -->
      <div class="col-md-3">
        <div class="card h-100 p-3 d-flex justify-content-between">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h4 class="mb-0">68%</h4>
              <small>Positive Sentiment</small>
            </div>
            <i class="bi bi-graph-up-arrow"></i>
          </div>
        </div>
      </div>

      <!-- Processed -->
      <div class="col-md-3">
        <div class="card h-100 p-3 d-flex justify-content-between">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h4 class="mb-0">892</h4>
              <small>Processed</small>
            </div>
            <i class="bi bi-bar-chart"></i>
          </div>
        </div>
      </div>

      <!-- Last Updated -->
      <div class="col-md-3">
        <div class="card h-100 p-3 d-flex justify-content-between">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h5 class="mb-1">2 hr ago</h5>
              <small>Last Updated</small>
            </div>
            <i class="bi bi-clock"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Action Cards -->
    <div class="row g-3 mt-2">
      <!-- Upload Data -->
      <div class="col-md-4">
        <div class="card h-100 p-3 text-center">
          <i class="bi bi-upload mb-2"></i>
          <h6>Upload New Data</h6>
          <p class="small mb-2">
            Start by uploading stakeholder comments in CSV format or paste text directly for immediate analysis.
          </p>
          <button class="btn btn-success">Upload Comments</button>
        </div>
      </div>

      <!-- Sentiment Analysis -->
      <div class="col-md-4">
        <div class="card h-100 p-3 text-center">
          <i class="bi bi-emoji-smile mb-2"></i>
          <h6>Sentiment Analysis</h6>
          <p class="small mb-2">
            View sentiment analysis with colored tags and comprehensive charts showing overall trends.
          </p>
          <button class="btn btn-success">View Analysis</button>
        </div>
      </div>

      <!-- Word Cloud -->
      <div class="col-md-4">
        <div class="card h-100 p-3 text-center">
          <i class="bi bi-chat-left-text mb-2"></i>
          <h6>Word Cloud</h6>
          <p class="small mb-2">
            Generate interactive word clouds to identify the most frequently mentioned topics and key themes.
          </p>
          <button class="btn btn-success">View Word Cloud</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
